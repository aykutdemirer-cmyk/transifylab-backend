# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Port is passed to uvicorn on the command line, not read from here.
# Default in the README is 8100 (8000 is often used by other local services).
APP_NAME="File Conversion & Transcription API"
ENVIRONMENT=development           # development | production
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# CORS  (comma-separated list of allowed origins for the SPA)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:3001

# ---------------------------------------------------------------------------
# Uploads / temp files
# ---------------------------------------------------------------------------
TEMP_DIR=.tmp
MAX_UPLOAD_SIZE_MB=100            # rejected with 413 above this
FILE_TTL_SECONDS=3600            # generated files expire after this
CLEANUP_INTERVAL_SECONDS=300     # background sweep frequency

# ---------------------------------------------------------------------------
# Transcription
# ---------------------------------------------------------------------------
TRANSCRIPTION_BACKEND=faster_whisper   # faster_whisper | openai

# -- faster_whisper (local) --
FW_MODEL_SIZE=large-v3          # tiny | base | small | medium | large-v3
FW_DEVICE=cpu                    # cpu | cuda
FW_COMPUTE_TYPE=int8             # int8 | int8_float16 | float16 | float32
# Leave FW_INITIAL_PROMPT empty. An instruction-style prompt makes large-v3
# hallucinate subtitle credits ("Altyazı M.K.") on real phone recordings.
FW_INITIAL_PROMPT=

# -- openai --
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# -- speaker diarization (sherpa-onnx, offline; models under models/diarization/) --
DIARIZATION_ENABLED=true
DIARIZATION_MAX_SPEAKERS=0       # 0 => auto-detect the number of speakers

# -- rule-based punctuation / capitalisation cleanup + hallucination drop --
TRANSCRIPT_CLEANUP=true

# -- ffmpeg filter chain run while transcoding .gsm/.amr/.3gp to WAV --
# high-pass + EBU R128 loudness normalisation lifts quiet phone recordings so
# the VAD/model hear them. Set empty to disable.
AUDIO_FILTER_CHAIN=highpass=f=85,loudnorm=I=-16:TP=-1.5:LRA=11

# ---------------------------------------------------------------------------
# Optional: high-fidelity DOCX -> PDF via LibreOffice
# ---------------------------------------------------------------------------
# SOFFICE_BIN=C:\Program Files\LibreOffice\program\soffice.exe
